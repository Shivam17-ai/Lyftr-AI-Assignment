# ==============================================================================
# LLM Chatbot with Key Failover & Cache - Environment Configuration
# ==============================================================================

# LLM API Keys (Pool of at least 2 keys, comma-separated)
# Keys are assigned positionally: key_1, key_2, key_3...
# IMPORTANT: Keys must come from separate accounts to avoid shared rate-limit buckets!
# - Primary Provider: Groq (free tier: ~30 req/min, no credit card required) -> https://console.groq.com/keys
# - Optional Providers:
#   * Cerebras -> https://cloud.cerebras.ai
#   * OpenRouter -> https://openrouter.ai/keys
LLM_API_KEYS=your_groq_key_1,your_groq_key_2

# LiteLLM Models (comma-separated, corresponding positionally to each key above)
# If only one model is provided, it applies to all keys.
# If fewer models than keys are provided, the last model is reused for remaining keys.
# Default primary model: groq/llama-3.3-70b-versatile
LLM_MODELS=groq/llama-3.3-70b-versatile,groq/llama-3.3-70b-versatile

# SQLite Database Storage URL
# Inside Docker, the volume is mounted at /data.
# Path format: sqlite:////data/app.db (or sqlite:///./app.db for local development without Docker)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS Origins (comma-separated)
# In production, add your deployed frontend domain (e.g. https://my-frontend.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Failure Simulation Header Toggle ("true" enables X-Simulate-Failure header; "false" ignores it)
ENABLE_FAILURE_SIMULATION=true

# Default System Prompt (used when no session-specific prompt is provided)
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# LLM Inference Parameters
# Deterministic temperature 0 maximizes response caching consistency
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Caching Configuration ("local" for in-memory, "disk" for persistent volume cache)
CACHE_TYPE=local
CACHE_DIR=/data/cache

# Frontend Configuration
# Build-time base URL for API requests
VITE_API_URL=http://localhost:8000
